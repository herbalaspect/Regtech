generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id          String    @id @default(cuid())
  domain      String    @unique
  settings    String    @default("{}")
  installedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  scans       Scan[]
}

model Product {
  id              String       @id @default(cuid())
  shopId          String
  shopifyId       String
  title           String
  description     String       @default("")
  bodyHtml        String       @default("")
  tags            String       @default("")
  productType     String       @default("")
  vendor          String       @default("")
  imageUrls       String       @default("[]")
  category        String?
  categoryOverride String?
  complianceScore String       @default("NOT_SCANNED")
  lastScannedAt   DateTime?
  contentHash     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  shop            Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  findings        Finding[]
  scans           Scan[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
  @@index([complianceScore])
}

model Finding {
  id           String   @id @default(cuid())
  productId    String
  scanId       String
  ruleId       String
  category     String
  severity     String
  title        String
  description  String
  affectedText String?
  suggestion   String?
  source       String
  resolved     Boolean  @default(false)
  dismissedAt  DateTime?
  dismissReason String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([scanId])
  @@index([severity])
}

model Scan {
  id          String    @id @default(cuid())
  shopId      String
  productId   String?
  scanType    String    @default("manual")
  status      String    @default("pending")
  totalProducts Int     @default(0)
  scannedCount  Int     @default(0)
  criticalCount Int     @default(0)
  warningCount  Int     @default(0)
  infoCount     Int     @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@index([shopId])
  @@index([productId])
}

model CustomRule {
  id          String  @id @default(cuid())
  shopId      String
  category    String
  ruleType    String
  severity    String
  name        String
  description String
  pattern     String?
  keywords    String  @default("[]")
  enabled     Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
}

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  action    String
  details   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
}
